# ── Scraping & Enrichment API Keys ──────────────────────────────────────────
APIFY_API_TOKEN=your_apify_token_here
APOLLO_API_KEY=your_apollo_api_key_here

# ── Universal Database Connection (Optional) ──────────────────────────────────
# Leave empty to use default local embedded SQLite (backend/data/master.db)
# Or configure ANY relational database:
# PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/leadintel?sslmode=require
# MySQL / MariaDB:
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/leadintel
# SQLite custom path:
# DATABASE_URL=sqlite:////path/to/custom_database.db
